# =============================================================================
# Carlos Dorneles Platform — environment variable template
#
# Copy to `.env.local` per app and fill in real values.
# NEVER commit real secrets. Only NEXT_PUBLIC_* values are exposed to browsers.
#
# Where each value is set:
#   - Sites/apps (browser + SSR): `.env.local` per app. NEXT_PUBLIC_* are inlined
#     at build, so a change needs a redeploy.
#   - Appwrite Functions: function Settings → Variables (see functions/README.md).
#   - Project-wide: Project Settings → Global variables. Shared by every site and
#     function, so one key covers all of them (a site variable can override).
# =============================================================================

# --- Appwrite (public, safe for the browser) ---------------------------------
# Endpoint and project ID are required to talk to Appwrite.
NEXT_PUBLIC_APPWRITE_ENDPOINT=
NEXT_PUBLIC_APPWRITE_PROJECT_ID=

# --- Appwrite (server-side only) ---------------------------------------------
# Same endpoint/project, read by the provisioning CLI, deploy scripts and CI.
APPWRITE_ENDPOINT=
APPWRITE_PROJECT_ID=
# API key used by server runtimes / Functions. Never expose to the browser.
APPWRITE_API_KEY=

# --- Observability -----------------------------------------------------------
# Sentry DSN is public-ish but environment-specific.
NEXT_PUBLIC_SENTRY_DSN=
# Auth token used at build time to upload source maps. Server-side only.
SENTRY_AUTH_TOKEN=

# --- Runtime -----------------------------------------------------------------
NODE_ENV=development
# Build version. Injected automatically by tooling/next-config.mjs from the root
# package.json — do not set it here.
# NEXT_PUBLIC_APP_VERSION=

# --- App features ------------------------------------------------------------
# Shows the "Criar conta" link on the login page. Default: false.
NEXT_PUBLIC_ENABLE_SIGN_UP=false

# --- Platform -----------------------------------------------------------------
# Appwrite Team whose members are the platform admins (root). Empty disables the
# platform bypass. The admin functions read this same key.
NEXT_PUBLIC_PLATFORM_TEAM_ID=

# --- Google auth -------------------------------------------------------------
# OAuth client id (browser). When unset, Google sign-in stays off entirely.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
# Kill switch. Only the exact value "false" (trimmed, case-insensitive) disables
# Google (button, One Tap and session-expired re-auth). Default: enabled.
# Os sites leem NEXT_PUBLIC_* em tempo de build, então desligar aqui só vale no
# navegador após um redeploy; a função one-tap-login lê em tempo de execução
# (imediato). O servidor sempre vence.
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=true

# --- Cloudflare Turnstile ----------------------------------------------------
# Site key (browser) do widget nas páginas públicas de auth. Sem ela, os forms
# mostram erro de configuração ao submeter (fail-closed, nunca ignoram).
# Dev/teste — test key oficial que sempre passa (Cloudflare docs):
#   NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
#   TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
# Falha sempre: sitekey 2x00000000000000000000AB / secret
# 2x0000000000000000000000000000000AB (útil p/ testar o caminho de erro).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# --- Appwrite Functions (function Settings → Variables) ----------------------
# Injected automatically by the Appwrite runtime — do not set these:
#   APPWRITE_FUNCTION_API_ENDPOINT, APPWRITE_FUNCTION_PROJECT_ID
# one-tap-login: the Google OAuth client id (same value as
# NEXT_PUBLIC_GOOGLE_CLIENT_ID). Required — without it the function returns 500.
GOOGLE_CLIENT_ID=
# create-user: login URL used in the welcome e-mail. Optional — without it the
# e-mail carries only the temporary password.
WELCOME_LOGIN_URL=
# public-auth: secret do Turnstile p/ o siteverify. Só server-side — nunca em
# NEXT_PUBLIC_* e nunca no código.
TURNSTILE_SECRET_KEY=

# --- Site deploys (scripts/deploy-sites.sh) ----------------------------------
# Defaults shown; override only when needed.
SITE_BUILD_RUNTIME=node-24
SITE_BUILD_SPECIFICATION=s-4vcpu-4gb
SITE_VCS_BRANCH=main
SITE_DOMAIN_SUFFIX=sites.cdorneles.com.br
SITE_NO_AUTODEPLOY_PATTERN=__no-autodeploy__
# VCS link (optional, from the Console's Git connection). Without both, sites
# deploy by upload.
SITE_INSTALLATION_ID=
SITE_REPOSITORY_ID=

# --- Tests (end-to-end) ------------------------------------------------------
E2E_EMAIL=
E2E_PASSWORD=
