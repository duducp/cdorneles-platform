# =============================================================================
# Carlos Dorneles Platform — environment variable template
#
# Copy to `.env.local` per app and fill in real values.
# NEVER commit real secrets. Only NEXT_PUBLIC_* values are exposed to browsers.
# =============================================================================

# --- Appwrite (public, safe for the browser) ---------------------------------
# Endpoint and project ID are required to talk to Appwrite.
NEXT_PUBLIC_APPWRITE_ENDPOINT=
NEXT_PUBLIC_APPWRITE_PROJECT_ID=

# --- Appwrite (server-side only) ---------------------------------------------
# API key used by server runtimes / Functions. Never expose to the browser.
APPWRITE_API_KEY=

# --- Observability -----------------------------------------------------------
# Sentry DSN is public-ish but environment-specific.
NEXT_PUBLIC_SENTRY_DSN=
# Auth token used at build time to upload source maps. Server-side only.
SENTRY_AUTH_TOKEN=

# --- Runtime -----------------------------------------------------------------
NODE_ENV=development

# --- Platform -----------------------------------------------------------------
# Appwrite Team whose members may create organizations (the platform team).
# One value for every site and for the admin functions, which read this same key.
NEXT_PUBLIC_PLATFORM_TEAM_ID=

# --- Google One Tap -----------------------------------------------------------
# OAuth client id (browser). When unset, Google One Tap stays off and only the
# classic "Entrar com Google" button is shown. Also set GOOGLE_CLIENT_ID on the
# one-tap-login function (same value).
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# --- Google auth kill switch --------------------------------------------------
# Set ONCE as an Appwrite project variable (Project settings → Global variables):
# it reaches every site and the one-tap-login function. "false"
# (case-insensitive, surrounding spaces ignored) disables Google (button, One
# Tap and session-expired re-auth); unset or any other value keeps
# it enabled. A site variable with the same key overrides the project value for
# that site. Changes need a redeploy.
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=
