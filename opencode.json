{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "appwrite": {
      "type": "local",
      "command": ["uvx", "mcp-server-appwrite"],
      "enabled": true,
      "environment": {
        "APPWRITE_ENDPOINT": "{env:NEXT_PUBLIC_APPWRITE_ENDPOINT}",
        "APPWRITE_PROJECT_ID": "{env:NEXT_PUBLIC_APPWRITE_PROJECT_ID}",
        "APPWRITE_API_KEY": "{env:APPWRITE_API_KEY}"
      }
    }
  }
}
